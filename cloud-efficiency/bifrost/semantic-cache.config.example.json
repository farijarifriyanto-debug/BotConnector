{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "disable_content_logging": true
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "providers": {
    "botconnector_embedding": {
      "keys": [
        {
          "name": "local-tei",
          "value": "not-needed",
          "models": ["text-embeddings-inference"],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "http://embeddings:80",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 30
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "embedding": true,
          "list_models": false
        }
      }
    }
  },
  "vector_store": {
    "enabled": true,
    "type": "redis",
    "config": {
      "addr": "redis-stack:6379",
      "db": 0,
      "username": "",
      "password": "",
      "pool_size": 50,
      "min_idle_conns": 2,
      "max_idle_conns": 10
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "semantic_cache",
      "config": {
        "cache_by_model": true,
        "cache_by_provider": true,
        "cleanup_on_shutdown": false,
        "conversation_history_threshold": 3,
        "dimension": 384,
        "embedding_model": "text-embeddings-inference",
        "exclude_system_prompt": false,
        "provider": "botconnector_embedding",
        "threshold": 0.92,
        "ttl": 3600,
        "vector_store_namespace": "botconnector-cloud-v1"
      }
    }
  ]
}
