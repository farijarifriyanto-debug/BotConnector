<Window
    x:Class="BotConnector.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BotConnector"
    Width="1380"
    Height="860"
    MinWidth="1050"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="#0B0F17"
    AllowDrop="True"
    DragOver="V2_DragOver"
    Drop="V2_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0F17"/>
        <SolidColorBrush x:Key="Surface" Color="#131A26"/>
        <SolidColorBrush x:Key="Surface2" Color="#1B2432"/>
        <SolidColorBrush x:Key="Border" Color="#28323F"/>
        <SolidColorBrush x:Key="Text" Color="#E6EAF0"/>
        <SolidColorBrush x:Key="Muted" Color="#8A94A6"/>
        <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1E2B44"/>
        <SolidColorBrush x:Key="Dark" Color="#0E1520"/>
        <SolidColorBrush x:Key="Dark2" Color="#161F2C"/>
        <SolidColorBrush x:Key="DarkBorder" Color="#28323F"/>
        <SolidColorBrush x:Key="Good" Color="#22C55E"/>

        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SoftButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <Style x:Key="NavButton"
               TargetType="Button"
               BasedOn="{StaticResource SoftButton}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D7E0EC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="9"
                            Background="{StaticResource Accent}">
                        <TextBlock Text="BC"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="9,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="BotConnector"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Personal AI Agent"
                                   FontSize="10"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource Surface2}"
                        CornerRadius="9"
                        Padding="12,6">
                    <TextBlock x:Name="WorkspaceText"
                               Text="Belum ada workspace"
                               MaxWidth="520"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Foreground="{StaticResource Text}"/>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <CheckBox x:Name="LocalAiCheck"
                              Content="Local AI"
                              Checked="LocalAi_Changed"
                              Unchecked="LocalAi_Changed"
                              Visibility="Collapsed"/>

                    <ComboBox x:Name="ModeBox"
                              Width="105"
                              Height="32"
                              Margin="0,0,7,0"
                              SelectionChanged="V4_ModeChanged"/>

                    <Border Background="#12241C"
                            CornerRadius="9"
                            Padding="9,5"
                            Margin="0,0,7,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource Good}"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="Hermes"
                                       Foreground="#86EFAC"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="OpenFolderButton"
                            Style="{StaticResource SoftButton}"
                            Content="Open Folder"
                            Click="OpenFolder_Click"
                            Margin="0,0,7,0"/>

                    <TextBlock x:Name="AuthStatusText"
                               Text="Not signed in"
                               Foreground="{StaticResource Muted}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0"/>

                    <Button x:Name="SignInButton"
                            Style="{StaticResource SoftButton}"
                            Content="Sign in"
                            Click="SignInButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="145"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="V2NewChatButton"
                            Grid.Row="0"
                            Style="{StaticResource PrimaryButton}"
                            Content="+  New Chat"
                            Click="V2_NewChat_Click"/>

                    <TextBlock Grid.Row="2"
                               Text="SESSIONS"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}"
                               Margin="4,0,0,5"/>

                    <ListBox x:Name="V2SessionList"
                             Grid.Row="3"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="V2_SessionChanged"
                             PreviewMouseRightButtonDown="V2_SessionList_RightDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename"
                                          Click="V2_RenameSession_Click"/>
                                <MenuItem Header="Delete"
                                          Click="V2_DeleteSession_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBlock Grid.Row="5"
                               Text="WORKSPACE"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}"
                               Margin="4,0,0,5"/>

                    <StackPanel Grid.Row="6">
                        <Button Style="{StaticResource NavButton}" Content="Files"/>
                        <Button Style="{StaticResource NavButton}" Content="Search"/>
                        <Button Style="{StaticResource NavButton}" Content="Git / Changes"/>
                        <Button Style="{StaticResource NavButton}" Content="Terminal"/>
                    </StackPanel>

                    <ListBox x:Name="FileList"
                             Grid.Row="7"
                             Margin="0,7,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="FileList_DoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                    <Button x:Name="RevokeButton"
                            Grid.Row="8"
                            Style="{StaticResource SoftButton}"
                            Content="Revoke Folder"
                            Click="Revoke_Click"
                            Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- CENTER CONVERSATION -->
            <Grid Grid.Column="1"
                  Margin="24,16,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Conversation"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Hermes brain  |  Windows local hands"
                                   FontSize="10"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button x:Name="AskModeButton"
                                Style="{StaticResource SoftButton}"
                                Content="Ask"
                                Tag="ask"
                                Click="V5_AgentMode_Click"
                                Margin="0,0,5,0"/>
                        <Button x:Name="AgentModeButton"
                                Style="{StaticResource PrimaryButton}"
                                Content="Agent"
                                Tag="agent"
                                Click="V5_AgentMode_Click"
                                Margin="0,0,5,0"/>
                        <Button x:Name="PlanModeButton"
                                Style="{StaticResource SoftButton}"
                                Content="Plan"
                                Tag="plan"
                                Click="V5_AgentMode_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0"
                        CornerRadius="10"
                        Padding="6">
                    <Grid>
                        <!-- Structured conversation renderer (virtualized cards) -->
                        <ListBox x:Name="ConversationList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,9,12,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- avatar -->
                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="8"
                                                Background="{Binding Accent}"
                                                VerticalAlignment="Top"
                                                Margin="0,1,11,0">
                                            <TextBlock Text="{Binding Avatar}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- content bubble -->
                                        <Border Grid.Column="1"
                                                Background="{Binding BubbleBg}"
                                                CornerRadius="10"
                                                Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}"
                                                       Margin="0,1,0,5"/>

                                            <ItemsControl ItemsSource="{Binding Blocks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <ContentControl Visibility="{Binding TextVisible}"
                                                                            Loaded="V5MarkdownText_Loaded"
                                                                            DataContextChanged="V5MarkdownText_DataContextChanged"/>
                                                            <Border Visibility="{Binding CodeVisible}"
                                                                    Background="#0F172A"
                                                                    CornerRadius="9"
                                                                    Margin="0,4">
                                                                <StackPanel>
                                                                    <Border Background="#1E293B"
                                                                            CornerRadius="9,9,0,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding LangLabel}"
                                                                                       Foreground="#94A3B8"
                                                                                       FontSize="10"
                                                                                       Margin="12,6,0,6"
                                                                                       VerticalAlignment="Center"/>
                                                                            <Button Grid.Column="1"
                                                                                    Click="V5CopyCode_Click"
                                                                                    Cursor="Hand"
                                                                                    Margin="0,3,5,3">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border Background="#334155"
                                                                                                CornerRadius="6"
                                                                                                Padding="9,3">
                                                                                            <TextBlock Text="Copy"
                                                                                                       Foreground="#E2E8F0"
                                                                                                       FontSize="10"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBox Text="{Binding Text}"
                                                                             IsReadOnly="True"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             Foreground="#E2E8F0"
                                                                             FontFamily="Cascadia Mono, Consolas"
                                                                             FontSize="12.5"
                                                                             Padding="12,10"
                                                                             TextWrapping="Wrap"
                                                                             HorizontalScrollBarVisibility="Disabled"
                                                                             VerticalScrollBarVisibility="Disabled"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <TextBlock x:Name="ConversationEmpty"
                                   Text="Open a project folder and send a message to start."
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- Legacy compatibility: hidden. Existing code paths
                             still read/write AssistantText and the TextChanged
                             handler stays wired; the visible surface is above. -->
                        <TextBox x:Name="AssistantText"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 TextChanged="V2_AssistantTextChanged"/>
                    </Grid>
                </Border>

                <!-- COMPACT COMPOSER -->
                <Border Grid.Row="2"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10"
                        Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="CommandBox"
                                 Grid.Row="0"
                                 MinHeight="34"
                                 MaxHeight="120"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontSize="13"
                                 Foreground="{StaticResource Text}"
                                 PreviewKeyDown="CommandBox_PreviewKeyDown"/>

                        <Border x:Name="AttachmentBar"
                                Grid.Row="1"
                                Background="{StaticResource Surface2}"
                                CornerRadius="8"
                                Padding="7"
                                Margin="0,7,0,0">
                            <StackPanel>
                                <TextBlock x:Name="AttachmentText"
                                           FontSize="10"
                                           Foreground="{StaticResource Muted}"/>
                                <ListBox x:Name="V2AttachmentList"
                                         MaxHeight="62"
                                         BorderThickness="0"
                                         Background="Transparent"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="InsertButton"
                                        Style="{StaticResource SoftButton}"
                                        Content="+"
                                        Click="InsertButton_Click"
                                        Margin="0,0,5,0"/>

                                <!-- Unnamed Web selector: presentation/state-ready -->
                                <ComboBox Width="118"
                                          Height="30"
                                          SelectedIndex="0"
                                          Margin="0,0,5,0"
                                          ToolTip="Internet search mode"
                                          Loaded="V53_WebModeLoaded"
                                          SelectionChanged="V53_WebModeChanged">
                                    <ComboBoxItem Content="Web: Auto"/>
                                    <ComboBoxItem Content="Web: Off"/>
                                    <ComboBoxItem Content="Web: Search"/>
                                    <ComboBoxItem Content="Deep Research"/>
                                    <ComboBoxItem Content="URL / Docs"/>
                                </ComboBox>

                                <Button x:Name="RunButton"
                                        Style="{StaticResource SoftButton}"
                                        Content="Run"
                                        Click="Run_Click"
                                        Visibility="Collapsed"
                                        Margin="0,0,5,0"/>

                                <Button x:Name="StopButton"
                                        Style="{StaticResource SoftButton}"
                                        Content="Stop"
                                        Click="Stop_Click"
                                        Visibility="Collapsed"/>
                            </StackPanel>

                            <Button x:Name="SendButton"
                                    Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Send"
                                    Click="V4_Send_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- CONTEXTUAL INSPECTOR -->
            <Border Grid.Column="2"
                    Background="{StaticResource Dark}"
                    BorderBrush="{StaticResource DarkBorder}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Inspector"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="ClearTerminalButton"
                                Grid.Column="1"
                                Style="{StaticResource SoftButton}"
                                Content="Clear"
                                Click="ClearTerminal_Click"
                                Padding="8,4"/>
                    </Grid>

                    <TabControl Grid.Row="1"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectedIndex="0">
                        <TabItem Header="Activity">
                            <Border Background="{StaticResource Dark2}"
                                    BorderBrush="{StaticResource DarkBorder}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="11">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT RUN"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8"
                                                   Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,12">
                                            <Ellipse x:Name="HermesStateDot"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="#94A3B8"
                                                     Margin="0,4,9,0"/>
                                            <StackPanel>
                                                <TextBlock x:Name="HermesStateText"
                                                           Text="Checking Hermes..."
                                                           Foreground="#F8FAFC"
                                                           FontSize="11"/>
                                                <TextBlock x:Name="HermesStateSub"
                                                           Text="127.0.0.1:18642"
                                                           Foreground="#94A3B8"
                                                           FontSize="9"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="230"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="#60A5FA"
                                                     Margin="0,4,9,0"/>
                                            <StackPanel>
                                                <TextBlock x:Name="V2ActivityText"
                                                           Text="Waiting for task"
                                                           Foreground="#F8FAFC"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="230"/>
                                                <TextBlock Text="Activity details remain available in Terminal"
                                                           Foreground="#94A3B8"
                                                           FontSize="9"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="230"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <TabItem Header="Changes">
                            <Border Background="{StaticResource Dark2}"
                                    BorderBrush="{StaticResource DarkBorder}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,8">
                                        <Button x:Name="V3GitStatusButton"
                                                Style="{StaticResource SoftButton}"
                                                Content="Status"
                                                Click="V3_GitStatus_Click"
                                                Padding="7,4"
                                                Visibility="Collapsed"/>
                                        <Button x:Name="V3GitDiffButton"
                                                Style="{StaticResource SoftButton}"
                                                Content="Diff"
                                                Click="V3_GitDiff_Click"
                                                Padding="7,4"
                                                Margin="0,0,5,0"/>
                                        <Button x:Name="V3ValidateButton"
                                                Style="{StaticResource SoftButton}"
                                                Content="Validate"
                                                Click="V3_Validate_Click"
                                                Padding="7,4"
                                                Margin="0,0,5,0"/>
                                        <Button x:Name="V3CommitButton"
                                                Style="{StaticResource SoftButton}"
                                                Content="Commit"
                                                Click="V3_Commit_Click"
                                                Padding="7,4"/>
                                    </StackPanel>

                                    <ListBox x:Name="V2ChangedFiles"
                                             Grid.Row="1"
                                             Background="Transparent"
                                             Foreground="#D5DEEB"
                                             BorderThickness="0"
                                             MouseDoubleClick="V2_ChangedFile_DoubleClick"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                </Grid>
                            </Border>
                        </TabItem>

                        <TabItem Header="Terminal">
                            <Border Background="{StaticResource Dark2}"
                                    BorderBrush="{StaticResource DarkBorder}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="9">
                                <TextBox x:Name="TerminalText"
                                         Background="Transparent"
                                         Foreground="#D5DEEB"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="10"/>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       FontSize="9"
                       Foreground="{StaticResource Muted}"/>
