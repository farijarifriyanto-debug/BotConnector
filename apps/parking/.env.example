# BotConnector Parking — environment example (NO real secrets).
# Copy to a root-only location (e.g. /etc/botconnector/parking.env) and fill in
# real values. Never commit real credentials.

# ---- Database --------------------------------------------------------------
# Dedicated Parking PostgreSQL database (isolated from other products).
PARKING_DATABASE_URL=postgresql+psycopg2://parking:CHANGE_ME@127.0.0.1:55432/botconnector_parking
# Test database (suffix _test enforced; never production).
PARKING_TEST_DATABASE_URL=postgresql+psycopg2://parking:CHANGE_ME@127.0.0.1:55432/botconnector_parking_test

# ---- Runtime ---------------------------------------------------------------
# Log level: DEBUG / INFO / WARNING / ERROR
PARKING_LOG_LEVEL=INFO
# Host/port for the local dev runner (127.0.0.1 only; not public).
PARKING_HOST=127.0.0.1
PARKING_PORT=8711

# ---- Edge sync -------------------------------------------------------------
# Edge identity is authenticated server-side via credential reference.
# PARKING_EDGE_CREDENTIAL_REFERENCE=

# ---- Payment provider adapter ----------------------------------------------
# M6 uses the deterministic simulator. Real providers plug in later.
PARKING_PAYMENT_ADAPTER=SIMULATOR

# ---- Evidence storage ------------------------------------------------------
# ANPR image/evidence references (no blobs in transactional DB).
# PARKING_EVIDENCE_STORAGE=local
# PARKING_EVIDENCE_DIR=/var/lib/botconnector-parking/evidence

# ---- Allowed origins / hosts ----------------------------------------------
# Comma-separated allowed CORS origins for the operator console.
PARKING_ALLOWED_ORIGINS=http://127.0.0.1:8711
