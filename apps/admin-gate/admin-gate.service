[Unit]
Description=BotConnector Admin Gate (central admin identity)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botadmin
Group=botadmin
WorkingDirectory=/home/botadmin/admin-gate
EnvironmentFile=/home/botadmin/admin-gate/.env
ExecStart=/home/botadmin/admin-gate/venv/bin/uvicorn admin_gate:app --host 127.0.0.1 --port 18160
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
