<script>
const $=s=>document.querySelector(s);
const $$=s=>Array.prototype.slice.call(document.querySelectorAll(s));
async function j(u,o){const r=await fetch(u,o);return r.json();}
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));
const money=n=>new Intl.NumberFormat('id-ID').format(Number(n||0));
const time=(d)=>d?new Date(d).toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}):'-';
const VIEWS={dashboard:'Dashboard',pos:'POS',orders:'Orders / Sales',products:'Products',inventory:'Inventory',transfers:'Transfers',restaurant:'Restaurant',kitchen:'Kitchen / KDS',reports:'Reports',integrasi:'Integrasi'};
let BRANCHES=[],REGISTERS=[],PRODUCTS=[];
function page(title,sub,body){return '<div class="page-head"><div><h1>'+esc(title)+'</h1><div class="sub">'+esc(sub||'')+'</div></div></div>'+body;}
function section(title,body){return '<div class="section"><h2>'+esc(title)+'</h2>'+body+'</div>';}
function table(cols,rows,empty){
  if(!rows||!rows.length)return '<div class="empty">'+(empty||'Belum ada data.')+'</div>';
  let h='<table><tr>';cols.forEach(c=>h+='<th>'+c.label+'</th>');h+='</tr>';
  rows.forEach(r=>{h+='<tr>';cols.forEach(c=>{let v=c.format?c.format(r[c.key]):esc(r[c.key]);h+='<td>'+v+'</td>';});h+='</tr>';});
  return h+'</table>';
}
function kpi(k,v,cls){return '<div class="kpi"><div class="k">'+esc(k)+'</div><div class="v '+(cls||'')+'">'+esc(v)+'</div></div>';}
function cards(list){return '<div class="grid kpis">'+list.map(x=>kpi(x.k,x.v,x.cls)).join('')+'</div>';}

async function renderDashboard(){
  const st=await j('/bisnis/api/state');
  if(!st.business)return page('Dashboard','Business Suite','<div class="empty">Belum ada business. Jalankan pilot seed.</div>');
  updateBranchSelect(st.branches);
  const d=st.dashboard;
  const list=[
    {k:'Penjualan Hari Ini',v:'Rp '+money(d.sales_today)},
    {k:'Transaksi',v:d.transaction_count_today},
    {k:'Rata-rata Ticket',v:'Rp '+money(d.average_ticket)},
    {k:'Order Restoran Terbuka',v:d.open_restaurant_orders,cls:d.open_restaurant_orders?'warn':''},
    {k:'KOT Pending',v:d.pending_kitchen_orders,cls:d.pending_kitchen_orders?'warn':''},
    {k:'Transfer Aktif',v:d.active_transfers}
  ];
  let low=d.low_stock||[];
  let lowHtml='';
  if(low.length){
    lowHtml=section('Stok Rendah','<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px">'+
      low.map(l=>'<div class="kpi"><div class="k">'+esc(l.branch_code)+' · '+esc(l.sku)+'</div><div class="v err">'+l.available+'</div><div style="font-size:11px;color:var(--mut)">Stok tersedia</div></div>').join('')+'</div>');
  }
  return page('Dashboard','Metrik bisnis langsung dari data operasional',cards(list)+lowHtml);
}

function updateBranchSelect(branches){
  const sel=$('#branchSelect');
  if(!sel||!branches)return;
  sel.innerHTML=branches.map(b=>'<option value="'+b.id+'">'+esc(b.name)+'</option>').join('');
  BRANCHES=branches;
}

async function renderPOS(){
  const st=await j('/bisnis/api/pos');
  if(!st.business)return page('POS','','<div class="empty">Belum ada business.</div>');
  updateBranchSelect(st.branches);
  REGISTERS=st.registers||[]; PRODUCTS=st.products||[];
  const prodItems=PRODUCTS.map(p=>'<div class="product-item" data-id="'+p.master_sku_id+'" data-sku="'+esc(p.sku)+'" data-price="'+(p.price||0)+'" data-name="'+esc(p.name)+'" onclick="addToCart(this)" tabindex="0" role="button" aria-label="Tambah '+esc(p.name)+'">'+
    '<div class="name">'+esc(p.name)+'</div>'+
    '<div class="price">'+money(p.price)+'</div>'+
    '<div class="stock">'+esc(p.barcode||'No barcode')+'</div>'+
    '</div>').join('');
  const regOpts=REGISTERS.map(r=>'<option value="'+r.id+'">'+esc(r.name||r.code)+'</option>').join('');
  const branchOpts=BRANCHES.map(b=>'<option value="'+b.id+'" data-wh="'+b.warehouse_id+'">'+esc(b.name)+'</option>').join('');
  const body='<div class="pos-layout">'+
    '<div class="pos-products">'+
      '<div class="row">'+
        '<input class="search" id="posSearch" placeholder="Cari produk / scan barcode" onkeyup="filterPOS(event)">'+
        '<div class="field"><label>Cabang</label><select id="posBranch">'+branchOpts+'</select></div>'+
        '<div class="field"><label>Register</label><select id="posReg">'+regOpts+'</select></div>'+
      '</div>'+
      '<div class="product-grid" id="posGrid">'+prodItems+'</div>'+
    '</div>'+
    '<div class="pos-cart">'+
      '<h3>Keranjang</h3>'+
      '<div class="cart-list" id="cartList"><div class="dim">Belum ada item.</div></div>'+
      '<div class="totals">'+
        '<div class="total-row"><span>Subtotal</span><span id="cartSubtotal">Rp 0</span></div>'+
        '<div class="total-row"><span>Diskon</span><span id="cartDiscount">Rp 0</span></div>'+
        '<div class="total-row grand"><span>Total</span><span id="cartTotal">Rp 0</span></div>'+
      '</div>'+
      '<div class="row" style="margin-top:14px">'+
        '<div class="field"><label>Tender</label><select id="posTender"><option value="CASH">Tunai</option><option value="QRIS_MANUAL">QRIS (manual)</option><option value="CARD_MANUAL">Kartu (manual)</option><option value="BANK_TRANSFER_MANUAL">Transfer Bank</option></select></div>'+
        '<div class="field"><label>Dibayar</label><input id="posBayar" type="number" placeholder="0" min="0"></div>'+
      '</div>'+
      '<button class="btn" style="width:100%;margin-top:12px" id="posPayBtn" onclick="checkout()">Bayar</button>'+
      '<div id="posMsg" class="dim" style="margin-top:10px"></div>'+
    '</div>'+
  '</div>';
  return page('POS','Kasir retail  -  scan barcode, pilih produk, tender, cetak struk',body);
}
window.addToCart=function(el){
  const id=Number(el.dataset.id), sku=el.dataset.sku, name=el.dataset.name, price=Number(el.dataset.price);
  let cart=getCart();
  const ex=cart.find(c=>c.id===id);
  if(ex)ex.qty++; else cart.push({id,sku,name,price,qty:1});
  setCart(cart); renderCart();
}
window.filterPOS=function(e){
  const v=e.target.value.toLowerCase();
  $$('#posGrid .product-item').forEach(el=>{
    const name=el.dataset.name.toLowerCase(), sku=el.dataset.sku.toLowerCase();
    el.style.display=(name.includes(v)||sku.includes(v))?'block':'none';
  });
  if(e.key==='Enter'&&v){
    const hit=$$('#posGrid .product-item').find(el=>el.style.display!=='none');
    if(hit)addToCart(hit);
  }
}
function getCart(){try{return JSON.parse(localStorage.getItem('bc_cart')||'[]');}catch(e){return [];}}
function setCart(c){localStorage.setItem('bc_cart',JSON.stringify(c));}
window.renderCart=function(){
  const cart=getCart();
  const list=$('#cartList'); const sub=$('#cartSubtotal'); const total=$('#cartTotal');
  if(!list)return;
  const subtotal=cart.reduce((s,c)=>s+c.price*c.qty,0);
  if(!cart.length){list.innerHTML='<div class="dim">Belum ada item.</div>';}
  else{list.innerHTML=cart.map((c,i)=>'<div class="cart-item"><div class="info"><div>'+esc(c.name)+'</div><div class="qty">'+c.qty+' x Rp '+money(c.price)+'</div></div><div class="total">Rp '+money(c.price*c.qty)+'</div></div>').join('');}
  if(sub)sub.textContent='Rp '+money(subtotal);
  if(total)total.textContent='Rp '+money(subtotal);
}
window.checkout=async function(){
  const cart=getCart(); if(!cart.length){$('#posMsg').textContent='Keranjang kosong.';return;}
  const branch=$('#posBranch'); const wh=branch.options[branch.selectedIndex].dataset.wh;
  const body={branch_id:Number(branch.value),register_id:Number($('#posReg').value),warehouse_id:Number(wh),lines:cart.map(c=>({master_sku_id:c.id,sku:c.sku,quantity:c.qty,unit_price:c.price})),tender_method:$('#posTender').value,amount_tendered:Number($('#posBayar').value||0),client_event_id:'ui-'+Date.now(),device_id:'UI-POS'};
  try{const res=await j('/bisnis/api/sale',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(res.ok&&res.sale){setCart([]);renderCart();$('#posMsg').textContent='Penjualan '+res.sale.receipt_number+' tercatat.';}
    else{$('#posMsg').textContent=res.error||'Gagal';}
  }catch(err){$('#posMsg').textContent=err.message;}
}

async function renderOrders(){
  const d=await j('/bisnis/api/orders');
  const sales=(d.sales||[]).map(s=>({receipt:s.receipt_number,status:s.status,total:'Rp '+money(s.total),tender:s.tender_method,channel:'Retail',type:'Penjualan',created:time(s.created_at)}));
  const orders=(d.orders||[]).map(o=>({no:o.order_number,status:o.status,channel:o.sales_channel,total:'Rp '+money(o.total),tender:'-',type:o.order_type||'Restaurant',created:time(o.created_at)}));
  const all=[...sales,...orders].sort((a,b)=>new Date(b.created)-new Date(a.created));
  const body='<div class="row"><input class="search" id="orderSearch" placeholder="Cari nomor order / struk" onkeyup="filterTable(this,\'#ordersTable\')"></div>'+
    section('Semua Order','<div id="ordersTable">'+table([{label:'No',key:'receipt',format:v=>v||'-'},{label:'Status',key:'status'},{label:'Kanal',key:'channel'},{label:'Tipe',key:'type'},{label:'Total',key:'total'},{label:'Tender',key:'tender'},{label:'Waktu',key:'created'}],all,'Belum ada order.')+'</div>');
  return page('Orders / Sales','Riwayat penjualan retail & order restoran',body);
}
window.filterTable=function(input,sel){const v=input.value.toLowerCase();$$(sel+' tr').forEach((tr,i)=>{if(i===0)return; const txt=tr.textContent.toLowerCase(); tr.style.display=txt.includes(v)?'':'none';});}

async function renderProducts(){
  const d=await j('/bisnis/api/products');
  const rows=(d.products||[]).map(p=>({sku:p.sku,name:p.name,category:p.category,barcode:p.barcode,safety:p.safety_stock}));
  const body='<div class="row"><input class="search" placeholder="Cari SKU / nama / barcode" onkeyup="filterTable(this,\'#productsTable\')"></div>'+
    section('Master Produk','<div id="productsTable">'+table([{label:'SKU',key:'sku'},{label:'Produk',key:'name'},{label:'Kategori',key:'category'},{label:'Barcode',key:'barcode'},{label:'Stok Aman',key:'safety'}],rows,'Belum ada produk.')+'</div>');
  return page('Products','Produk / Master SKU',body);
}

async function renderInventory(){
  const d=await j('/bisnis/api/inventory');
  const low=(d.low||[]);
  const rows=(d.stock||[]).map(s=>({branch:s.branch_code,sku:s.sku,on_hand:s.on_hand,reserved:s.reserved,in_transit:s.in_transit,available:s.available}));
  let lowHtml='';
  if(low.length){
    lowHtml=section('Stok Rendah','<div class="grid kpis">'+low.map(l=>kpi(l.branch_code+' · '+l.sku,l.available,'err')).join('')+'</div>');
  }
  const body=lowHtml+section('Stok per Lokasi','<div id="inventoryTable">'+table([{label:'Cabang',key:'branch'},{label:'SKU',key:'sku'},{label:'Stok Fisik',key:'on_hand'},{label:'Dipesan',key:'reserved'},{label:'Dalam Perjalanan',key:'in_transit'},{label:'Stok Tersedia',key:'available'}],rows,'Belum ada stok.')+'</div>');
  return page('Inventory','Stok per lokasi (location-aware)',body);
}

async function renderTransfers(){
  const d=await j('/bisnis/api/transfers');
  const rows=(d.transfers||[]).map(t=>({no:t.transfer_number,from:t.source_branch_code||'-',to:t.dest_branch_code||'-',status:t.status,items:t.item_count||0,qty:t.total_qty||0,created:time(t.created_at)}));
  const body=section('Transfer Stok','<div id="transfersTable">'+table([{label:'No Transfer',key:'no'},{label:'Dari Cabang',key:'from'},{label:'Ke Cabang',key:'to'},{label:'Status',key:'status'},{label:'Items',key:'items'},{label:'Qty',key:'qty'},{label:'Dibuat',key:'created'}],rows,'Belum ada transfer.')+'</div>');
  return page('Transfers','Transfer stok antar cabang',body);
}

async function renderRestaurant(){
  const d=await j('/bisnis/api/restaurant');
  const menuRows=(d.menu||[]).map(m=>({name:m.name,price:'Rp '+money(m.price),category:m.category||'-',stocked:m.is_stocked?'Ya':'Tidak'}));
  const orderRows=(d.orders||[]).map(o=>({no:o.order_number,status:o.status,channel:o.sales_channel,total:'Rp '+money(o.total),type:o.order_type,created:time(o.created_at)}));
  const body=section('Menu','<div id="menuTable">'+table([{label:'Menu',key:'name'},{label:'Harga',key:'price'},{label:'Kategori',key:'category'},{label:'Stoked',key:'stocked'}],menuRows,'Belum ada menu.')+'</div>')+
    section('Order Terbuka','<div id="restoOrdersTable">'+table([{label:'No',key:'no'},{label:'Status',key:'status'},{label:'Kanal',key:'channel'},{label:'Tipe',key:'type'},{label:'Total',key:'total'},{label:'Waktu',key:'created'}],orderRows,'Belum ada order restoran.')+'</div>');
  return page('Restaurant','Menu & order restoran',body);
}

async function renderKitchen(){
  const d=await j('/bisnis/api/kitchen');
  const lanes={NEW:{label:'Baru',items:[]},PREPARING:{label:'Diproses',items:[]},READY:{label:'Siap',items:[]},SERVED:{label:'Selesai',items:[]}};
  (d.kots||[]).forEach(k=>{
    const lane=lanes[k.status]||lanes.NEW;
    lane.items.push('<div class="kds-card"><div class="kot">'+esc(k.kot_number)+'</div><div class="meta">'+esc(k.order_number)+' · '+time(k.created_at)+'</div><div class="items">'+esc((k.items||[]).map(i=>i.name+' x'+i.qty).join(', '))+'</div></div>');
  });
  const body='<div class="kds">'+Object.entries(lanes).map(([k,l])=>'<div class="kds-lane"><h3>'+l.label+' <span class="badge info">'+l.items.length+'</span></h3>'+(l.items.length?l.items.join(''):'<div class="dim" style="font-size:12px">Kosong</div>')+'</div>').join('')+'</div>';
  return page('Kitchen / KDS','Kitchen Order Ticket',body);
}

async function renderReports(){
  const d=await j('/bisnis/api/reports');
  if(!d.reports)return page('Reports','','<div class="empty">Belum ada data laporan.</div>');
  const r=d.reports.restaurant,ret=d.reports.retail;
  const list=[
    {k:'Gross Sales Restoran',v:'Rp '+money(r.gross_sales)},
    {k:'COGS Restoran',v:'Rp '+money(r.cogs)},
    {k:'Gross Profit',v:'Rp '+money(r.gross_profit)},
    {k:'Gross Margin',v:r.gross_margin_pct+'%'},
    {k:'Penjualan Retail',v:'Rp '+money(ret.gross_sales)}
  ];
