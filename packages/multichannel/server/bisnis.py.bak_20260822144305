.pos-products{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;min-height:400px}
.pos-cart{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px;position:sticky;top:20px}
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;margin-top:12px}
.product-item{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;cursor:pointer;transition:.15s}
.product-item:hover{border-color:var(--acc)}
.product-item .name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.product-item .price{font-size:12px;color:var(--acc);margin-top:4px}
.product-item .stock{font-size:10px;color:var(--mut);margin-top:2px}
.cart-list{max-height:320px;overflow:auto;margin:10px 0}
.cart-item{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--line)}
.cart-item:last-child{border-bottom:none}
.cart-item .info{font-size:13px}
.cart-item .info .qty{font-size:11px;color:var(--mut)}
.cart-item .total{font-size:13px;font-weight:700}
.totals{border-top:2px solid var(--line);padding-top:12px;margin-top:12px}
.total-row{display:flex;justify-content:space-between;font-size:13px;margin-bottom:6px}
.total-row.grand{font-size:18px;font-weight:800;margin-top:8px}
.kds{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.kds-lane{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;min-height:300px}
.kds-lane h3{display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--mut);margin-bottom:12px}
.kds-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:12px;margin-bottom:10px}
.kds-card .kot{font-size:14px;font-weight:700}
.kds-card .meta{font-size:11px;color:var(--mut);margin-top:4px}
.kds-card .items{font-size:12px;margin-top:8px;line-height:1.5}
.mobile-menu{display:none;width:40px;height:40px;border:1px solid var(--line);background:var(--card);color:var(--txt);border-radius:8px;cursor:pointer}
@media(max-width:900px){
  .app{grid-template-columns:1fr}
  aside.sidebar{position:fixed;left:0;top:0;bottom:0;z-index:60;transform:translateX(-100%);transition:.2s}
  .sidebar-open aside.sidebar{transform:translateX(0)}
  main.workspace{margin-left:0}
  .mobile-menu{display:flex;align-items:center;justify-content:center}
  .pos-layout{grid-template-columns:1fr}
  .kds{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:560px){
  .kpis{grid-template-columns:repeat(2,1fr)}
  .kds{grid-template-columns:1fr}
}
