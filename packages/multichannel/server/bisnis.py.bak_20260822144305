def get_user_id(request: Request):
    """
    OWNER_ONLY_PILOT authorization.

    Do not trust X-BotConnector-User-ID as proof of authorization.
    Validate the existing signed bc_admin cookie through the canonical
    BotConnector Admin Gate on loopback.
    """
    import json as _json
    import urllib.request as _urlrequest

    admin_cookie = request.cookies.get("bc_admin", "")
    supplied_identity = request.headers.get(
        "X-BotConnector-User-ID", ""
    ).strip()

    if not admin_cookie:
        # A caller trying to assert identity without a valid admin
        # session is explicitly forbidden.
        if supplied_identity:
            raise HTTPException(
                status_code=403,
                detail="Admin authorization required",
            )

        raise HTTPException(
            status_code=401,
            detail="Authentication required",
        )

    req = _urlrequest.Request(
        "http://127.0.0.1:18160/check",
        headers={
            "Cookie": "bc_admin=" + admin_cookie,
            "Accept": "application/json",
        },
        method="GET",
    )

    try:
        with _urlrequest.urlopen(req, timeout=3) as response:
            payload = _json.loads(
                response.read().decode("utf-8")
            )
    except Exception:
        # Fail closed if authorization service is unavailable.
        raise HTTPException(
            status_code=503,
            detail="Authorization service unavailable",
        )

    if not isinstance(payload, dict) or not payload.get("admin"):
        raise HTTPException(
            status_code=403,
            detail="Admin authorization required",
        )

    admin_identity = str(payload.get("email") or "").strip().lower()

    if not admin_identity:
        raise HTTPException(
            status_code=403,
            detail="Admin authorization required",
        )

    return admin_identity
APP = FastAPI(title="BotConnector Local Business", version="1.0.0")

_TENANT = "LOCAL-PILOT"


def _default_business():
    """Resolve the default PILOT business for the UI."""
    bizs = core.list_business(_TENANT)
    if not bizs:
        return None
    return bizs[0]


def _branch_map(business_id: int) -> dict:
    """branch_id -> warehouse_id."""
    return {b["id"]: b["warehouse_id"] for b in core.list_branch(business_id)}


# ============================================================ API
@APP.get("/bisnis/api/state", dependencies=[Depends(get_user_id)])
def state():
    biz = _default_business()
    if not biz:
        return {"ok": True, "business": None}
    branches = core.list_branch(biz["id"])
    dash = reporting.dashboard(biz["id"])
    return {"ok": True, "business": biz, "branches": branches,
            "dashboard": dash, "tenant": _TENANT}


@APP.get("/bisnis/api/products", dependencies=[Depends(get_user_id)])
def products():
    with db.koneksi() as c:
        cur = c.cursor()
        cur.execute(
            """SELECT m.id, m.sku, p.name, p.category, m.barcode, m.safety_stock
               FROM multichannel.master_sku m
               JOIN multichannel.product p ON p.id=m.product_id
               ORDER BY m.sku""")
        return {"ok": True, "products": cur.fetchall()}


